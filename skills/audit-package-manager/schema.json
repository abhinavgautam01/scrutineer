{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit-package-manager report",
  "type": "object",
  "required": ["review_status", "findings", "notes"],
  "additionalProperties": false,
  "properties": {
    "review_status": {
      "type": "string",
      "enum": ["reviewed", "missing-threat-model", "not-applicable"]
    },
    "findings": { "$ref": "../_shared/audit-findings.schema.json#/properties/findings" },
    "notes": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "source_sink_inventory": { "$ref": "#/$defs/evidence_list" },
    "negative_results": { "$ref": "#/$defs/evidence_list" },
    "unverified_assumptions": { "$ref": "#/$defs/evidence_list" },
    "design_properties": { "$ref": "#/$defs/evidence_list" }
  },
  "if": {
    "properties": { "review_status": { "enum": ["missing-threat-model", "not-applicable"] } }
  },
  "then": {
    "properties": { "findings": { "maxItems": 0 } }
  },
  "else": {
    "required": ["scope", "source_sink_inventory", "negative_results", "unverified_assumptions", "design_properties"]
  },
  "$defs": {
    "evidence_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

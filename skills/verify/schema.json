{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "verify report",
  "type": "object",
  "required": ["status", "attempts", "criteria"],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["confirmed", "fixed", "inconclusive", "deferred", "not_attempted"]
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["local-safe", "external-reach"]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["classification", "justification"]
    },
    "attempts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poc_well_formed",
        "reproduces_three_of_three",
        "claimed_failure_class",
        "public_interface_to_first_party_sink",
        "deterministic"
      ],
      "properties": {
        "poc_well_formed": { "$ref": "#/$defs/criterion" },
        "reproduces_three_of_three": { "$ref": "#/$defs/criterion" },
        "claimed_failure_class": { "$ref": "#/$defs/criterion" },
        "public_interface_to_first_party_sink": { "$ref": "#/$defs/criterion" },
        "deterministic": { "$ref": "#/$defs/criterion" }
      }
    },
    "reproducer": {
      "type": "string",
      "description": "The exact reproduction run against ./src: script, commands, and crafted input, verbatim."
    },
    "evidence": {
      "type": "string",
      "description": "Relevant stdout, stderr, exit codes, traces, and observed behavior across the attempts."
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "outcome", "evidence", "failure_class", "crash_site"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 3 },
        "outcome": {
          "type": "string",
          "enum": ["reproduced", "not_reproduced", "not_attempted"]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Attempt-specific output, or the concrete reason this attempt could not start."
        },
        "failure_class": {
          "type": "string",
          "description": "Observed failure class; empty when no target failure occurred."
        },
        "crash_site": {
          "type": "string",
          "description": "First-party crash/sink site; empty when it could not be established."
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "method", "evidence", "counterevidence", "proof_gap", "confidence"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "not_attempted"]
        },
        "method": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "counterevidence": { "type": "string" },
        "proof_gap": { "type": "string" },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "notAttemptedCriteria": {
      "type": "object",
      "properties": {
        "poc_well_formed": { "properties": { "verdict": { "const": "not_attempted" } } },
        "reproduces_three_of_three": { "properties": { "verdict": { "const": "not_attempted" } } },
        "claimed_failure_class": { "properties": { "verdict": { "const": "not_attempted" } } },
        "public_interface_to_first_party_sink": { "properties": { "verdict": { "const": "not_attempted" } } },
        "deterministic": { "properties": { "verdict": { "const": "not_attempted" } } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "deferred" } }, "required": ["status"] },
      "then": {
        "required": ["preflight"],
        "properties": {
          "preflight": {
            "properties": { "classification": { "const": "external-reach" } }
          },
          "attempts": {
            "items": { "properties": { "outcome": { "const": "not_attempted" } } }
          },
          "criteria": { "$ref": "#/$defs/notAttemptedCriteria" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "not_attempted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "attempts": {
            "items": { "properties": { "outcome": { "const": "not_attempted" } } }
          },
          "criteria": { "$ref": "#/$defs/notAttemptedCriteria" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "confirmed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "attempts": {
            "items": { "properties": { "outcome": { "const": "reproduced" } } }
          },
          "criteria": {
            "properties": {
              "poc_well_formed": { "properties": { "verdict": { "const": "pass" } } },
              "reproduces_three_of_three": { "properties": { "verdict": { "const": "pass" } } },
              "claimed_failure_class": { "properties": { "verdict": { "const": "pass" } } },
              "public_interface_to_first_party_sink": { "properties": { "verdict": { "const": "pass" } } },
              "deterministic": { "properties": { "verdict": { "const": "pass" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fixed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "attempts": {
            "items": { "properties": { "outcome": { "const": "not_reproduced" } } }
          },
          "criteria": {
            "properties": {
              "reproduces_three_of_three": { "properties": { "verdict": { "const": "fail" } } }
            }
          }
        }
      }
    }
  ]
}
